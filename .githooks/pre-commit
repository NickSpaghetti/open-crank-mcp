#!/usr/bin/env bash
# Runs the parts of the test suite the staged changes could break; CI runs all of it.
# Enable with `make hooks`, bypass with --no-verify. Tests the working tree, not the
# staged snapshot.
set -uo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$staged" ]; then
  echo "pre-commit: nothing staged"
  exit 0
fi

# Markdown-only commits run the doc link check and nothing else.
if ! printf '%s\n' "$staged" | grep -qv '\.md$'; then
  echo "pre-commit: only Markdown staged"
  if ! make check-doc-links; then
    echo "pre-commit: check-doc-links failed" >&2
    exit 1
  fi
  exit 0
fi

matches() { printf '%s\n' "$staged" | grep -qE "$1"; }

want_go=false        # Go sources: the server itself
want_c=false         # the C harness and its own test suite
want_sim=false       # anything that changes what a real Simulator does
want_shared=false    # the shared/VNC profile and its browser tests

matches '\.go$|^go\.(mod|sum)$'                              && want_go=true
# internal/plugincontract reads the manifests, so a plugin/ edit can break a Go test.
matches '^plugin/'                                           && want_go=true
matches '^c-harness/'                                        && want_c=true
matches '\.go$|^lua/|^c-harness/|^internal/(harness|simulator|build|screenshot|contracttest)/' && want_sim=true
# Named rather than `^scripts/`, so unrelated scripts don't fire the browser suite.
# Each name is checked against the tree, since a stale name would silently match nothing.
shared_paths='scripts/shared-check.sh
scripts/shared-lib.sh
scripts/shared-watch.sh
scripts/run-vnc.sh
scripts/ensure-xauth.sh
scripts/find-volume-slider.awk
tests/browser
docker-compose.yml
Dockerfile'

while IFS= read -r shared_path; do
	[ -e "$shared_path" ] || {
		printf 'pre-commit: the shared filter names %s, which does not exist.\n' "$shared_path" >&2
		printf '  Update shared_paths in .githooks/pre-commit, and ci.yml alongside it.\n' >&2
		exit 1
	}
done <<SHARED_PATHS
$shared_paths
SHARED_PATHS

matches "^($(printf '%s' "$shared_paths" | sed 's/\./\\./g' | paste -sd'|' -))(\$|/)" && want_shared=true

# Checked once up front, rather than failing mid-run with a daemon socket error.
if $want_c || $want_sim || $want_shared; then
  if ! docker info >/dev/null 2>&1; then
    echo "pre-commit: Docker is not running, and the staged changes need it." >&2
    echo "  Start Docker and retry, or --no-verify if you have already run make test." >&2
    exit 1
  fi
fi

run() {
  echo "pre-commit: $*"
  if ! make "$@"; then
    echo "pre-commit: $* failed" >&2
    exit 1
  fi
}

# Cheapest first. check-doc-links is unconditional: a link breaks when its target
# moves, which needn't touch any .md.
run check-doc-links
$want_go     && run no-regex
$want_go     && run go-test
$want_shared && run test-shared-unit
# Diff-scoped; the full run happens in CI.
$want_go     && run mutation-test-diff
$want_c      && run test-c-harness
$want_sim    && run smoke-check
$want_sim    && run sdk-contract-check
$want_shared && run test-shared-browser

echo "pre-commit: ok"
