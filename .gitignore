# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/open-crank-mcp
*.pdx

# Playdate Simulator's native crash reporter writes this in its working directory.
.sentry-native/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Simulator Data directory bind-mounted by the shared profile its owned by root.
/.shared-data/

# Its old name, still ignored: being root-owned, existing checkouts can't easily remove it.
/.byos-data/

# Build output and vendored harnesses the native contract tests leave in the fixtures.
/c-harness/test/fixture-game/build/
/c-harness/test/fixture-game/src/mcp_harness.c
/c-harness/test/fixture-game/src/mcp_harness.h
/lua/test-fixture/Source/mcp_harness.lua

# Release binaries, as built by release.yml.
/dist/

# specmatic's report from `make mcp-auto-test`, at specmatic's own default path.
/build/

# Editor/IDE
# .vscode/

# IntelliJ / GoLand
.idea/
*.iml
*.iws
*.ipr
out/

# Browser test dependencies and output, written by the Playwright container.
/tests/browser/node_modules/
/tests/browser/test-results/
/tests/browser/playwright-report/
